1           ; initialize counter to 1
100         ; push limit (100)

while  do     ; while counter <= limit

    dup 15 % 0 = if
        "FizzBuzz" print
    else
        dup 3 % 0 = if
            "Fizz" print
        else
            dup 5 % 0 = if
                "Buzz" print
            else
                print
    end

    1 +       ; increment counter
end




