; (Maybe future testing) test 10 10 + 20 expect end (OK|FAILED)

; Maths operations
; 10 10 + print
; 20 10 - print
; 5 20 / print
; 5 20 % print

; Logical operations
; 10 10 = print
; 5 10 < print
; 10 4 > print
; 10 4 <= print
; 10 4 >= print
; 20 10 != print

; Stack operations
; nip print
; over print
; dup print

; 5 while dup 0 > do dup print 1 - dup end

; 10 10 = if "equal" print else "not equal" print endif
; 1 ? if "zero" print else "not zero" print endif

; Define a variable
; POPs the value from the stack and stores it in a variable
; const variable end

; Load variable
; Loads the value of the variable and pushes it onto the stack
; variable @

; Store value into a variable
; Type sensitive
; variable !

; Supported Types
; INT | String | Float
