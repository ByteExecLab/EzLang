word firstEvenBelow 1
    ; Expects: ( n -- e )
    ; Returns the first even number <= n.
    while dup 0 > do
        dup 2 % 0 = if
            return
        endif
        1 -
    end
end

10 firstEvenBelow print   ; -> 10
9 firstEvenBelow print    ; -> 8
5 firstEvenBelow print    ; -> 4
1 firstEvenBelow print    ; -> ??? (currently: loop finishes with 0, then word returns with 0 or leaves nothing, depending on your design)
